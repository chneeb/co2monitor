# Device path (required)
DEVICE=/dev/hidraw2

# Prometheus listen address (optional, default :8080)
LISTEN_ADDR=:8080

# Additional flags (optional)
# To enable MQTT, uncomment and fill in:
#EXTRA_FLAGS=--mqtt-host raspberrypi:1883 --mqtt-topic sensors/co2 --mqtt-co2-threshold 1800

# To force a specific protocol:
#EXTRA_FLAGS=--plaintext
#EXTRA_FLAGS=--encrypted

EXTRA_FLAGS=
